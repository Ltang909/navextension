{
  "manifest_version": 3,
  "name": "Gesture Nav",
  "version": "0.1.0",
  "description": "Control scrolling, back/forward, zoom, and tabs with hand gestures and voice.",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "sidepanel.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Open Gesture Nav"
  }
}
